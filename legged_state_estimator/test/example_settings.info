legged_state_estimator
{
  worldFrameName world_link
  baseFrameName base_link
  imuFrameName imu_link
  contactFrames
  {
    [0] FL_foot
    [1] FR_foot
    [2] RL_foot
    [3] RR_foot
  }

  useContactEstimator false

  contactEstimatorSettings
  {
    beta0
    {
      [0] -20.0
      [1] -20.0
      [2] -20.0
      [3] -20.0
    }

    beta1
    {
      [0] 0.7
      [1] 0.7
      [2] 0.7
      [3] 0.7
    }

    contactForceCovarianceAlpha 100.0

    contactProbabilityThreshold 0.5
  }

  noiseSettings
  {
    gyroscopeNoise 0.01
    gyroscopeBiasNoise 0.00001
    accelerometerNoise 0.1
    accelerometerBiasNoise 0.0001
    contactNoise 0.1
  }

  dynamicContactEstimation false

  contactPositionNoise 0.01

  contactRotationNoise 0.01

  samplingTime 0.01

  lpfGyroAccelCutoffFrequency 250
  lpfLinAccelCutoffFrequency 250
  lpfDqJCutoffFrequency 10
  lpfDdqJCutoffFrequency 5
  lpfTauJCutoffFrequency 10
}