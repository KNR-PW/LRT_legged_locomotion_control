legged_state_estimator
{
  worldFrameName world
  baseFrameName trunk_link
  imuFrameName imu_link
  
  contactFrames
  {
    [0] RFF_link
    [1] RRF_link
    [2] LFF_link
    [3] LRF_link
  }

  ; Radii of spherical end effectors [m] (frames are in sphere centers), rolling of feet is compensated.
  ; 0.0: point or surface (6 DoF) contact. Same order as contactFrames
  contactSphereRadii
  {
    [0] 0.035
    [1] 0.035
    [2] 0.035
    [3] 0.035
  }

  useContactEstimator false

  contactEstimatorSettings
  {
    beta0
    {
      [0] -10.0
      [1] -10.0
      [2] -10.0
      [3] -10.0
    }

    beta1
    {
      [0] 0.7
      [1] 0.7
      [2] 0.7
      [3] 0.7
    }

    contactForceCovarianceAlpha 0.1

    contactProbabilityThreshold 0.1
  }

  noiseSettings
  {
    gyroscopeNoise 0.01
    gyroscopeBiasNoise 0.0001
    accelerometerNoise 0.1
    accelerometerBiasNoise 0.001

    ; Velocity noise of end effector in contact (slip, rolling). Too small value makes kinematics change
    ; the orientation when end effector slips, bigger one gives bigger drift of base height
    contactNoise 0.05

    ; Initial uncertainty of IMU biases (accuracy of bias calibration before activation), gyroscope [rad/s],
    ; accelerometer [m/s^2]. Big gyroscope value makes yaw rate too small (bias is changed instead)
    initialGyroscopeBiasNoise 0.001
    initialAccelerometerBiasNoise 0.1
  }

  dynamicContactEstimation true

  contactPositionNoise 0.01

  contactRotationNoise 0.01

  samplingTime 0.002

  lpfGyroAccelCutoffFrequency 200
  lpfLinAccelCutoffFrequency 200
  lpfDqJCutoffFrequency 30
  lpfDdqJCutoffFrequency 30
  lpfTauJCutoffFrequency 30
}